.DS_Store
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.quarto/
*_cache/
*_files/
outputs/*
!outputs/.gitkeep
data/updates/*
!data/updates/.gitkeep

# LaTeX slide build intermediates. Public decks use lesson-1.pdf and lesson-2.pdf.
slides/lesson-*/main.aux
slides/lesson-*/main.bbl
slides/lesson-*/main.blg
slides/lesson-*/main.fdb_latexmk
slides/lesson-*/main.fls
slides/lesson-*/main.log
slides/lesson-*/main.nav
slides/lesson-*/main.out
slides/lesson-*/main.pdf
slides/lesson-*/main.snm
slides/lesson-*/main.toc
slides/lesson-*/main.vrb

# LaTeX handout build intermediates. Public handouts keep main.tex and the
# explicitly named handout PDF.
labs/*/handout/main.aux
labs/*/handout/main.fdb_latexmk
labs/*/handout/main.fls
labs/*/handout/main.log
labs/*/handout/main.out
labs/*/handout/main.pdf
labs/*/handout/*.aux
labs/*/handout/*.fdb_latexmk
labs/*/handout/*.fls
labs/*/handout/*.log
labs/*/handout/*.out

# Lab-specific instructor materials remain local so the public repository and
# student release cannot expose answers or the construction of teaching data.
instructor/data/
instructor/lab-2-*/
instructor/lab-2-*.md
instructor/prepare-lab-2-*.R
instructor/release-audit-lab-2-v1.0.*.md

# Local packaging workspaces; published ZIPs are attached to GitHub releases.
release-candidates/
.Rproj.user
